# Database
DATABASE_URL=

# Server Configuration
PORT=8012
NODE_ENV=development  # development, production, test
FRONTEND_URL=http://localhost:5173

# Email Configuration

POSTMARK_USERNAME=""
SENDER_EMAIL="contact@100xdevs.com"
DASHBOARD_URL="https://review.100xdevs.com"

# File Storage Configuration
CDN_BASE_UPLOAD_URL= 
CDN_BASE_ACCESS_URL= 
CDN_API_KEY= 


# JWT Configuration
JWT_ACCESS_SECRET="change_this_to_secure_random_string"
JWT_REFRESH_SECRET="change_this_to_different_secure_random_string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRY_MS="604800000"  # 7 days in milliseconds

# Logging Configuration
LOG_DIR="logs"
LOG_LEVEL="debug"  # debug, info, warn, error

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=250
